<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Exclude /app directory so Flutter web app runs independently
  RewriteRule ^app(/.*)?$ - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
