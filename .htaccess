<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Exclude /api and /app directories so PHP endpoints and Flutter run directly
  RewriteRule ^api(/.*)?$ - [L]
  RewriteRule ^app(/.*)?$ - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
